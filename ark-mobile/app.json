{
  "expo": {
    "name": "Tentzu",
    "slug": "ark-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arkmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tentzu.app"
    },
    "android": {
      "package": "com.tentzu.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e8f6f6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "194109ba-2bb7-4b78-a25a-7f9c6429a362"
      }
    },
    "owner": "ademola25"
  }
}
