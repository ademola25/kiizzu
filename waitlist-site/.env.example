# MySQL — from hPanel > Databases (or hosting_createAccountDatabaseV1)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Password for /admin (the signup dashboard) and the CSV export.
# If unset, every admin route returns 404 rather than defaulting to open.
# Use something long and random: openssl rand -base64 24
ADMIN_TOKEN=

# Optional abuse limits (defaults: 30 signups per IP per 10 minutes)
# RATE_MAX=30
# RATE_WINDOW_MS=600000
